# Environment Configuration Template
# Copy this to .env and fill in your values

# Environment (development, production, test)
NODE_ENV=development

# Database Paths (optional - defaults will be used if not set)
# DB_PATH_PRODUCTION=./data/care_circle_prod.db
# DB_PATH_DEVELOPMENT=./care_circle.db
# DB_PATH_SIMULATION=./care_circle_simulation.db
# DB_PATH_TEST=:memory:

# Explicit DB Path Override (optional - overrides all other settings)
# DB_PATH=

# API Keys
GEMINI_API_KEY_0="your_gemini_key_0"
GEMINI_API_KEY="your_gemini_key"
GEMINI_API_KEY1="your_gemini_key_1"
CHAT_GPT_KEY="your_openai_key"
AISENSY_API_KEY="your_aisensy_key"

# Model Configuration
DEBUG_CLI="false"
OLLAMA_API_BASE_URL="http://127.0.0.1:8001"
OLLAMA_DEFAULT_MODEL="llama3.2:latest"
DEFAULT_MODEL="llama3.2:latest"
FALLBACK_MODEL="llama3.2:latest"
USE_ONLY_OPENAI=true

# JWT Secret (for future auth implementation)
# JWT_SECRET="your_secret_key_here"
