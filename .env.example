# Copy to .env. Fill only the providers and integrations you use.
# Llama is first, then Bedrock, OpenAI, Gemini, and optional local Ollama.
# A remote provider is skipped unless its API key is present.
# LLAMA_API_URL defaults to the research endpoint in config.js when blank.
HOST=127.0.0.1
PORT=5000
ORCHESTRATOR_URL=http://127.0.0.1:5000
NODE_ENV=development

# Model providers
LLAMA_API_URL=
LLAMA_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=
CHAT_GPT_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_0=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
OLLAMA_API_BASE_URL=
OLLAMA_DEFAULT_MODEL=
USE_ONLY_OPENAI=false
DEFAULT_MODEL=
FALLBACK_MODEL=
BASIC_RESPONSES_MODEL=
CONVERSATIONAL_AGENT_MODEL=
ESCALATION_MODEL=
CRITICAL_ANALYSIS_MODEL=
SYNTHETIC_USER_MODEL=

# Database and simulation
DB_PATH=
DB_PATH_DEVELOPMENT=./data/dbs/care_circle_dev.db
DB_PATH_PRODUCTION=/app/data/dbs/care_circle_prod.db
DB_PATH_SIMULATION=./data/dbs/care_circle_simulation.db
DB_PATH_TEST=:memory:
SIMULATION_MODE=false
SIMULATION_DEBUG=false
TRAINING_MODE=
METRICS_COLLECTION=
ANNOTATOR_ID=
CURRENT_PROMPT_VERSION=
PROMPT_VERSION=

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/storage/local
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_GCP_BUCKET=
STORAGE_GCP_PROJECT_ID=

# Optional integrations and authentication
ICD_API_URL=
ICD_API_KEY=
AISENSY_API_URL=
AISENSY_API_KEY=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
REQUIRE_COGNITO_LOGIN=false

# Diagnostics
DEBUG_CLI=false
DEBUG_COMPANION=false
DEBUG_ESCALATION=false
