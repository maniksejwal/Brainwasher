# Copy to .env. Fill only the providers and integrations you use.
# Llama is first, then Bedrock, OpenAI, Gemini, and optional local Ollama.
# A remote provider is skipped unless its API key is present.
# LLAMA_API_URL defaults to the research endpoint in config.js when blank.
HOST=127.0.0.1
PORT=5000
ORCHESTRATOR_URL=http://127.0.0.1:5000
NODE_ENV=development

# Model providers
LLAMA_API_URL=
LLAMA_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=
CHAT_GPT_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_0=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
OLLAMA_API_BASE_URL=
OLLAMA_DEFAULT_MODEL=
USE_ONLY_OPENAI=false
DEFAULT_MODEL=
FALLBACK_MODEL=
BASIC_RESPONSES_MODEL=
CONVERSATIONAL_AGENT_MODEL=
ESCALATION_MODEL=
CRITICAL_ANALYSIS_MODEL=
SYNTHETIC_USER_MODEL=

# Database and simulation
DB_PATH=
DB_PATH_DEVELOPMENT=./data/dbs/care_circle_dev.db
DB_PATH_PRODUCTION=/app/data/dbs/care_circle_prod.db
DB_PATH_SIMULATION=./data/dbs/care_circle_simulation.db
DB_PATH_TEST=:memory:
SIMULATION_MODE=false
SIMULATION_DEBUG=false
TRAINING_MODE=
METRICS_COLLECTION=
ANNOTATOR_ID=
CURRENT_PROMPT_VERSION=
PROMPT_VERSION=

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/storage/local
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_GCP_BUCKET=
STORAGE_GCP_PROJECT_ID=

# Optional integrations and authentication
ICD_API_URL=
ICD_API_KEY=
AISENSY_API_URL=
AISENSY_API_KEY=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
REQUIRE_COGNITO_LOGIN=false
# Admin and reviewer roles cannot be chosen at login. Grant them by username (comma-separated),
# or set ALLOW_SELF_ASSIGNED_ROLES=true for local development and simulations only.
ADMIN_USERNAMES=
REVIEWER_USERNAMES=
ALLOW_SELF_ASSIGNED_ROLES=false
# Browser origins allowed to call the API (comma-separated); unset allows any origin
CORS_ORIGINS=

# HealthyMitra integration (signed service requests, /api/integrations/healthymitra)
# Where the signing keys come from: "env" (local development) or "aws" (Secrets Manager)
SERVICE_SECRETS_SOURCE=env
# env: one key per direction; *_PREVIOUS is accepted too while a key is being rotated.
# Use long random values, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HEALTHYMITRA_TO_AI_SECRET=
HEALTHYMITRA_TO_AI_SECRET_PREVIOUS=
AI_TO_HEALTHYMITRA_SECRET=
AI_TO_HEALTHYMITRA_SECRET_PREVIOUS=
# aws: secret names or ARNs; each value is JSON {"current": "...", "previous": "..."}
HEALTHYMITRA_TO_AI_SECRET_ID=
AI_TO_HEALTHYMITRA_SECRET_ID=
# How often keys are reloaded from Secrets Manager (default 15 minutes)
SERVICE_SECRETS_REFRESH_MS=900000
# Signed requests allowed per HealthyMitra user, per route, per minute
INTEGRATION_RATE_LIMIT_PER_MINUTE=60

# Diagnostics
DEBUG_CLI=false
DEBUG_COMPANION=false
DEBUG_ESCALATION=false
